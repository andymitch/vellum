<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.vellum" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Edge-to-edge: let the themed web header draw behind the system bars.
             Transparent bars + no auto contrast scrim, so the bar background is
             whatever the web app paints (respects the in-app theme).
             Light: dark status-bar icons. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
    </style>
</resources>
